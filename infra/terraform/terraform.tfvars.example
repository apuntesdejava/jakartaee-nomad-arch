# ============================================================================
# Azure Configuration
# ============================================================================

resource_group_name = "jakartaee-nomad-demo-rg"
location            = "eastus"

# ============================================================================
# Virtual Machine Configuration
# ============================================================================

vm_size        = "Standard_B2s"
admin_username = "azureuser"
# Reemplaza este valor con el contenido completo de tu propio archivo .pub.
admin_ssh_public_key = "ssh-ed25519 AAAA... jakartaee-nomad-azure"

# ============================================================================
# Security Configuration
# ============================================================================

# Cambia esto a tu IP pública para mayor seguridad
my_ip = "0.0.0.0/0"  # Permite acceso desde cualquier lugar (dev)

# ============================================================================
# Database Configuration
# ============================================================================

mysql_server_name   = "jakartaee-nomad-mysql-unique" # CAMBIAR ESTO: Debe ser único globalmente en Azure
mysql_root_password = "RootPassword123!"
mysql_user          = "appuser"
mysql_password      = "AppPassword123!"
